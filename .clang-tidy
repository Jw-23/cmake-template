---
# Strict checks for project-owned code. Macro definitions and macro-generated
# registration objects are excluded where clang-tidy provides that option.
FormatStyle: file

Checks: >
  -*,
  bugprone-*,
  clang-analyzer-*,
  cppcoreguidelines-*,
  modernize-*,
  performance-*,
  readability-*,
  -android-*,
  -bugprone-macro-parentheses,
  -bugprone-multiple-statement-macro,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-macro-usage,
  -llvmlibc-*,
  -llvm-*,
  -modernize-use-trailing-return-type,
  -objc-*,
  -readability-magic-numbers

WarningsAsErrors: '*'
HeaderFilterRegex: ''

CheckOptions:
  - key: bugprone-use-after-move.MovedStandardClasses
    value: 'std::basic_string;std::vector;std::list;std::map;std::set;std::unique_ptr;std::shared_ptr;std::optional;std::function'

  - key: cppcoreguidelines-avoid-non-const-global-variables.IgnoreMacros
    value: 'true'

  - key: cppcoreguidelines-pro-type-member-init.IgnoreArrays
    value: 'true'

  - key: readability-function-cognitive-complexity.IgnoreMacros
    value: 'true'

  - key: readability-function-size.IgnoreMacros
    value: 'true'

  - key: readability-identifier-length.MinimumVariableNameLength
    value: '1'

  - key: readability-simplify-boolean-expr.IgnoreMacros
    value: 'true'
...
